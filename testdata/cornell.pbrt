# Small original Cornell-style scene; no external assets. Units: meters.
Film "rgb" "integer xresolution" 96 "integer yresolution" 96
Sampler "independent" "integer pixelsamples" 32
Integrator "path" "integer maxdepth" 8
LookAt 0 1 -3.2 0 1 1 0 1 0
Camera "perspective" "float fov" 40
WorldBegin
Material "diffuse" "rgb reflectance" [.73 .73 .73]
# Floor, ceiling and back wall, normals facing inside.
Shape "trianglemesh" "point3 P" [-1 0 0  1 0 0  1 0 2  -1 0 2] "integer indices" [0 2 1 0 3 2]
Shape "trianglemesh" "point3 P" [-1 2 0  1 2 0  1 2 2  -1 2 2] "integer indices" [0 1 2 0 2 3]
Shape "trianglemesh" "point3 P" [-1 0 2  1 0 2  1 2 2  -1 2 2] "integer indices" [0 2 1 0 3 2]
AttributeBegin
 Material "diffuse" "rgb reflectance" [.63 .065 .05]
 Shape "trianglemesh" "point3 P" [-1 0 0 -1 0 2 -1 2 2 -1 2 0] "integer indices" [0 2 1 0 3 2]
AttributeEnd
AttributeBegin
 Material "diffuse" "rgb reflectance" [.14 .45 .09]
 Shape "trianglemesh" "point3 P" [1 0 0 1 0 2 1 2 2 1 2 0] "integer indices" [0 1 2 0 2 3]
AttributeEnd
AttributeBegin
 AreaLightSource "diffuse" "rgb L" [12 12 12]
 Shape "trianglemesh" "point3 P" [-.32 1.99 .7 .32 1.99 .7 .32 1.99 1.3 -.32 1.99 1.3] "integer indices" [0 1 2 0 2 3]
AttributeEnd
ObjectBegin "ball"
 Shape "sphere" "float radius" .36
ObjectEnd
AttributeBegin
 Translate -.42 .36 1.15
 ObjectInstance "ball"
AttributeEnd
AttributeBegin
 Translate .43 .36 .7
 ObjectInstance "ball"
AttributeEnd
